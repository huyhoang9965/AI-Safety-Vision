DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/safety_db
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=ai-safety-monitoring
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# false: dang ky xong co the dang nhap ngay trong moi truong phat trien
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AI_DEVICE=auto
DETECTION_CONFIDENCE=0.20
RF_DETR_INFERENCE_FPS=2
RF_DETR_INPUT_SIZE=384
PERSON_LOCATOR_TILING=false
PERSON_LOCATOR_INPUT_SIZE=960
AI_PRELOAD_MODELS=true
AI_CPU_THREADS=4
AI_MAX_CONCURRENT_INFERENCE=1
VIDEO_OUTPUT_MAX_WIDTH=1280
VIDEO_ENCODE_PRESET=ultrafast
# VIDEO_MANIFEST_PATH=D:/AI_Safety_Monitoring/outputs/video_audit/video_manifest_FINAL_kaggle.csv
# VIDEO_DATASET_ROOT=D:/AI_Safety_Monitoring/Datasets/Safe_Unsafe
# OUTPUT_DIR=D:/AI_Safety_Monitoring/storage/outputs

# Chatbot LLM (server only; never use NEXT_PUBLIC_ for this key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
CHAT_TIMEOUT_SECONDS=45
CHAT_MAX_OUTPUT_TOKENS=1200
CHAT_MAX_TOOL_ROUNDS=4
CHAT_HISTORY_MESSAGES=16
CHAT_TEMPERATURE=0.65
# Keep false unless internal-data sharing with OpenRouter/model providers is approved.
CHAT_LLM_SHARE_INTERNAL_DATA=false
CHAT_TTS_ENABLED=true
CHAT_TTS_MODEL=google/gemini-3.8-flash-tts
# Keep false until sending internal answer text to OpenRouter/Google TTS is approved.
CHAT_TTS_SHARE_INTERNAL_DATA=false
